<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 管理员清单（requireAdministrator），双击即提权 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <RootNamespace>CapsLockPro</RootNamespace>
  </PropertyGroup>

  <!-- 阶段6 UIA / MSAA 用的 COM 互操作程序集（按需启用：-p:EnableUia=true） -->
  <ItemGroup Condition="'$(EnableUia)' == 'true'">
    <COMReference Include="UIAutomationClient">
      <Guid>944de083-8fb8-4cf2-8e6e-8b22f0670e69</Guid>
      <VersionMajor>1</VersionMajor>
      <VersionMinor>0</VersionMinor>
      <Lcid>0</Lcid>
      <WrapperTool>tlbimp</WrapperTool>
      <Isolated>false</Isolated>
      <EmbedInteropTypes>true</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Icon\CapsLock++.ico">
      <Link>Icon\CapsLock++.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="CapsLock++.json">
      <Link>CapsLock++.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
