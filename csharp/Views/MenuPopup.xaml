<Window x:Class="CapsLockPro.Views.MenuPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="菜单" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent" FontFamily="{StaticResource UiFont}"
        KeyDown="Window_KeyDown" Deactivated="Window_Deactivated">
    <Border x:Name="Card" Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题（AHK h45 / s13 bold ≈ 17px） -->
            <StackPanel Grid.Row="0">
                <TextBlock x:Name="TitleText" FontWeight="Bold" FontSize="17"
                           Foreground="{StaticResource TextBrush}"
                           HorizontalAlignment="Center" Margin="0,14,0,12"/>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"/>
            </StackPanel>

            <!-- 菜单项（AHK leftMargin/rightMargin=15, btnHeight=42, btnGap=6, numberWidth=30） -->
            <StackPanel Grid.Row="1" x:Name="ItemsHost" Margin="15,4,15,4"/>

            <!-- 关闭（AHK h36） -->
            <StackPanel Grid.Row="2" Margin="15,4,15,12">
                <Button Style="{StaticResource Btn}" Content="关闭 (Esc)" MinHeight="36"
                        HorizontalAlignment="Stretch" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
