<Window x:Class="CapsLockPro.Views.MenuPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="菜单" Width="320" SizeToContent="Height"
        WindowStyle="None" Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}"
        KeyDown="Window_KeyDown" Deactivated="Window_Deactivated">
    <Border Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <StackPanel Grid.Row="0">
                <TextBlock x:Name="TitleText" FontWeight="Medium" FontSize="14"
                           Foreground="{StaticResource TextBrush}"
                           Margin="12,10,12,8"/>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"/>
            </StackPanel>

            <!-- 菜单项 -->
            <StackPanel Grid.Row="1" x:Name="ItemsHost" Margin="6,4"/>

            <!-- 关闭 -->
            <StackPanel Grid.Row="2" Margin="6,4,6,10">
                <Button Style="{StaticResource Btn}" Content="关闭 (Esc)" HorizontalAlignment="Stretch" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
