<Window x:Class="CapsLockPro.Views.MenuPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="菜单" Width="320" SizeToContent="Height"
        WindowStyle="None" Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}"
        KeyDown="Window_KeyDown" Deactivated="Window_Deactivated">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource AccentBrush}">
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleBarText}"/>
        </Border>
        <StackPanel Grid.Row="1" x:Name="ItemsHost" Margin="10,8"/>
        <StackPanel Grid.Row="2" Margin="10,0,10,12">
            <Button Style="{StaticResource Btn}" Content="关闭 (Esc)" HorizontalAlignment="Stretch" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
