<Window x:Class="CapsLockPro.Views.ConfigHelperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置助手" Width="760" Height="540"
        MinWidth="640" MinHeight="420"
        Topmost="True" ShowInTaskbar="True" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 卡片区 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- 左卡片：菜单组 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Top" Text="菜单组" FontWeight="Medium" Margin="0,0,0,8"/>
                        <ListBox x:Name="GroupList" SelectionChanged="GroupList_SelectedIndexChanged"/>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button Style="{StaticResource Btn}" Content="添加" Click="AddGroup_Click" Margin="0,0,4,0"/>
                        <Button Style="{StaticResource Btn}" Content="编辑" Click="EditGroup_Click" Margin="0,0,4,0"/>
                        <Button Style="{StaticResource BtnDanger}" Content="删除" Click="DeleteGroup_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="True"/>

            <!-- 右卡片：菜单项 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="菜单项" FontWeight="Medium" Margin="0,0,0,8"/>
                    <ListBox Grid.Row="1" x:Name="ItemList" SelectionChanged="ItemList_SelectedIndexChanged" MouseDoubleClick="ItemList_MouseDoubleClick"/>
                    <!-- 操作工具条 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Style="{StaticResource Btn}" Content="添加" Click="AddItem_Click" Margin="0,0,4,0"/>
                        <Button Style="{StaticResource Btn}" Content="编辑" Click="EditItem_Click" Margin="0,0,4,0"/>
                        <Button Style="{StaticResource BtnDanger}" Content="删除" Click="DeleteItem_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource Btn}" Content="上移" Click="MoveUp_Click" Margin="0,0,4,0"/>
                        <Button Style="{StaticResource Btn}" Content="下移" Click="MoveDown_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部 -->
        <DockPanel Grid.Row="1" LastChildFill="False">
            <Button DockPanel.Dock="Left" Style="{StaticResource Btn}" Content="终端路径..." Click="TerminalPaths_Click" Margin="0,12,8,0"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Style="{StaticResource Btn}" Content="重新加载配置" Click="Reload_Click" Margin="0,0,8,0"/>
                <Button Style="{StaticResource BtnPrimary}" Content="保存配置" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
