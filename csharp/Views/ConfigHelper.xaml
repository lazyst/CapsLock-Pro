<Window x:Class="CapsLockPro.Views.ConfigHelperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配置助手" Width="720" Height="520"
        Topmost="True" ShowInTaskbar="True" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 菜单组 -->
            <DockPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock DockPanel.Dock="Top" Text="菜单组" FontWeight="Medium" Margin="0,0,0,6"/>
                <ListBox x:Name="GroupList" SelectionChanged="GroupList_SelectedIndexChanged"/>
            </DockPanel>

            <!-- 操作按钮（组 + 项） -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Width="120">
                <TextBlock Text="菜单组操作" FontWeight="Medium" Margin="0,0,0,6"/>
                <Button Style="{StaticResource Btn}" Content="添加组" Click="AddGroup_Click" Margin="0,0,0,4"/>
                <Button Style="{StaticResource Btn}" Content="编辑组" Click="EditGroup_Click" Margin="0,0,0,4"/>
                <Button Style="{StaticResource BtnDanger}" Content="删除组" Click="DeleteGroup_Click" Margin="0,0,0,12"/>

                <TextBlock Text="菜单项操作" FontWeight="Medium" Margin="0,0,0,6"/>
                <Button Style="{StaticResource Btn}" Content="添加项" Click="AddItem_Click" Margin="0,0,0,4"/>
                <Button Style="{StaticResource Btn}" Content="编辑项" Click="EditItem_Click" Margin="0,0,0,4"/>
                <Button Style="{StaticResource BtnDanger}" Content="删除项" Click="DeleteItem_Click" Margin="0,0,0,4"/>
                <Button Style="{StaticResource Btn}" Content="↑ 上移" Click="MoveUp_Click" Margin="0,0,0,4"/>
                <Button Style="{StaticResource Btn}" Content="↓ 下移" Click="MoveDown_Click"/>
            </StackPanel>

            <!-- 菜单项 -->
            <DockPanel Grid.Column="2" Margin="5,0,0,0">
                <TextBlock DockPanel.Dock="Top" Text="菜单项" FontWeight="Medium" Margin="0,0,0,6"/>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="SearchBox" Height="28" TextChanged="SearchBox_TextChanged"/>
                </DockPanel>
                <ListBox x:Name="ItemList" SelectionChanged="ItemList_SelectedIndexChanged"/>
            </DockPanel>
        </Grid>

        <!-- 底部 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource Btn}" Content="重新加载配置" Click="Reload_Click" Margin="0,0,8,0"/>
            <Button Style="{StaticResource BtnPrimary}" Content="保存配置" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
