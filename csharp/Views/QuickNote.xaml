<Window x:Class="CapsLockPro.Views.QuickNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="速记" Width="780" Height="540"
        Topmost="True" ShowInTaskbar="True" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="NoteListItem" TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource LightAccentBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBgBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：分类 / 搜索 / 操作 -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="10,8,10,4">
            <TextBlock Text="分类:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <ComboBox x:Name="CategoryBox" Width="120" Height="28" SelectionChanged="CategoryBox_SelectionChanged" Margin="0,0,6,4"/>
            <Button Style="{StaticResource Btn}" x:Name="NewCategoryBtn" Content="新建分类" Click="NewCategory_Click" Margin="0,0,8,4"/>
            <Button Style="{StaticResource Btn}" x:Name="RenameCategoryBtn" Content="重命名分类" Click="RenameCategory_Click" Margin="0,0,8,4"/>
            <Button Style="{StaticResource BtnDanger}" x:Name="DeleteCategoryBtn" Content="删除分类" Click="DeleteCategory_Click" Margin="0,0,8,4"/>
            <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="8,0,4,0"/>
            <TextBox x:Name="SearchBox" Width="150" Height="28" TextChanged="SearchBox_TextChanged" Margin="0,0,8,4"/>
            <Button Style="{StaticResource BtnPrimary}" x:Name="SaveBtn" Content="保存" Click="Save_Click" Margin="0,0,8,4"/>
            <Button Style="{StaticResource Btn}" x:Name="NewNoteBtn" Content="新建速记" Click="NewNote_Click" Margin="0,0,8,4"/>
            <Button Style="{StaticResource BtnDanger}" x:Name="DeleteBtn" Content="删除" Click="Delete_Click" Margin="0,0,8,4"/>
            <Button Style="{StaticResource Btn}" x:Name="CloseBtn" Content="关闭" Click="Close_Click" Margin="0,0,8,4"/>
        </WrapPanel>

        <!-- 双列：左列表 + 右编辑区 -->
        <Grid Grid.Row="1" Margin="10,4,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="180"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListView Grid.Column="0" x:Name="NoteList" MouseDoubleClick="NoteList_DoubleClick"
                      ItemContainerStyle="{StaticResource NoteListItem}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="标题" Width="160" DisplayMemberBinding="{Binding Title}"/>
                        <GridViewColumn Header="修改时间" Width="120" DisplayMemberBinding="{Binding MtimeText}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource BgBrush}"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="标题" Margin="0,0,0,2"
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                <TextBox Grid.Row="1" x:Name="TitleBox" Margin="0,0,0,6" MinHeight="34"
                         FontSize="15" FontWeight="Bold"
                         TextChanged="TitleBox_TextChanged"/>
                <TextBlock Grid.Row="2" Text="正文" Margin="0,0,0,2"
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 行号 gutter：与 BodyBox 同字体同行高，按滚动偏移平移对齐 -->
                    <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                            ClipToBounds="True" Padding="4,4,4,4">
                        <TextBlock x:Name="LineNumbers" Text="1"
                                   FontFamily="{StaticResource UiFont}" FontSize="14"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextAlignment="Right" HorizontalAlignment="Stretch"
                                   VerticalAlignment="Top">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="LineNumTransform"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>
                    <TextBox Grid.Column="1" x:Name="BodyBox" AcceptsReturn="True" AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             FontFamily="{StaticResource UiFont}" TextChanged="BodyBox_TextChanged"
                             SizeChanged="BodyBox_SizeChanged"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <TextBlock Grid.Row="2" x:Name="StatusBar" Margin="10,2,10,8"
                   Foreground="{StaticResource HintTextBrush}" FontSize="12"
                   Text="提示: Ctrl+S 保存 | 双击列表载入 | 新建速记清空编辑区"/>
    </Grid>
</Window>
