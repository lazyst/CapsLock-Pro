<Window x:Class="CapsLockPro.Views.QuickNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="速记" Width="540" Height="500"
        Topmost="True" ShowInTaskbar="True" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 按钮/搜索栏 -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="10,8,10,4">
            <Button Style="{StaticResource Btn}" x:Name="ViewToggleBtn" Content="查看速记" Click="ViewToggle_Click" Margin="0,0,8,4"/>
            <TextBlock x:Name="SearchLabel" Text="搜索:" VerticalAlignment="Center" Margin="8,0,4,0" Visibility="Collapsed"/>
            <TextBox x:Name="SearchBox" Width="160" Height="28" Visibility="Collapsed" Margin="0,0,8,4"
                     TextChanged="SearchBox_TextChanged"/>
            <Button Style="{StaticResource BtnPrimary}" x:Name="SaveBtn" Content="保存" Click="Save_Click" Margin="0,0,8,4"/>
            <Button Style="{StaticResource Btn}" x:Name="NewNoteBtn" Content="新建速记" Click="NewNote_Click" Margin="0,0,8,4"/>
            <Button Style="{StaticResource Btn}" x:Name="CancelBtn" Content="取消" Click="Cancel_Click" Margin="0,0,8,4"/>
            <Button Style="{StaticResource BtnDanger}" x:Name="DeleteBtn" Content="删除选中" Click="Delete_Click" Margin="0,0,8,4" Visibility="Collapsed"/>
        </WrapPanel>

        <!-- 内容区：编辑框 / 列表 切换 -->
        <TextBox Grid.Row="1" x:Name="EditBox" Margin="10,4,10,4" AcceptsReturn="True" AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="{StaticResource UiFont}"
                 Text="## "/>
        <ListView Grid.Row="1" x:Name="NoteList" Margin="10,4,10,4" Visibility="Collapsed" MouseDoubleClick="NoteList_DoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="文件名" Width="200" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="修改时间" Width="130" DisplayMemberBinding="{Binding Mtime}"/>
                    <GridViewColumn Header="目标" Width="80" DisplayMemberBinding="{Binding Target}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- 状态提示 -->
        <TextBlock Grid.Row="2" x:Name="StatusBar" Margin="10,2,10,8"
                   Foreground="{StaticResource HintTextBrush}" FontSize="12"
                   Text="提示: 输入标题或删除## | 最后一行使用==目标==指定保存位置 | Ctrl+S保存"/>
    </Grid>
</Window>
