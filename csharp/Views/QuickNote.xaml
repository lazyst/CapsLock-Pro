<Window x:Class="CapsLockPro.Views.QuickNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="速记" Width="780" Height="540"
        Topmost="True" ShowInTaskbar="True" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style x:Key="NoteListItem" TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource LightAccentBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverBgBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主内容区：左列(列表/分类) + 分隔条 + 右列(详情编辑) -->
        <!-- 按钮就近归属：左列顶栏管列表/分类，右列顶栏管当前速记详情，空间即语义 -->
        <Grid Grid.Row="0" Margin="10,8,10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="160"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左列：顶栏(分类/搜索/新建速记) + 速记列表 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="分类:" VerticalAlignment="Center" Margin="0,0,4,0" Height="28"/>
                    <ComboBox x:Name="CategoryBox" Width="120" Height="28" SelectionChanged="CategoryBox_SelectionChanged" Margin="0,0,6,4"/>
                    <Button Style="{StaticResource Btn}" x:Name="NewCategoryBtn" Content="新建分类" Click="NewCategory_Click" Margin="0,0,6,4"/>
                    <Button Style="{StaticResource Btn}" x:Name="RenameCategoryBtn" Content="重命名" Click="RenameCategory_Click" Margin="0,0,6,4"/>
                    <Button Style="{StaticResource BtnDanger}" x:Name="DeleteCategoryBtn" Content="删除分类" Click="DeleteCategory_Click" Margin="0,0,6,4"/>
                    <TextBox x:Name="SearchBox" Width="150" MinHeight="32" Padding="6,2" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" Margin="0,0,6,4"/>
                    <Button Style="{StaticResource BtnPrimary}" x:Name="NewNoteBtn" Content="新建速记" Click="NewNote_Click" Margin="0,0,0,4"/>
                </WrapPanel>
                <ListView Grid.Row="1" x:Name="NoteList" PreviewMouseLeftButtonUp="NoteList_Click"
                          ItemContainerStyle="{StaticResource NoteListItem}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="标题" Width="100" DisplayMemberBinding="{Binding Title}"/>
                            <GridViewColumn Header="修改时间" Width="120" DisplayMemberBinding="{Binding MtimeText}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"/>

            <!-- 右列：顶栏(保存/删除/关闭) + 标题/正文编辑 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- 右列顶栏：操作当前速记详情/窗口 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                    <Button Style="{StaticResource BtnPrimary}" x:Name="SaveBtn" Content="保存" Click="Save_Click" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource BtnDanger}" x:Name="DeleteBtn" Content="删除" Click="Delete_Click" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource Btn}" x:Name="CloseBtn" Content="关闭" Click="Close_Click"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="标题" Margin="42,0,0,2"
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                <TextBox Grid.Row="2" x:Name="TitleBox" Margin="42,0,0,6" MinHeight="34"
                         FontSize="15" FontWeight="Bold"
                         TextChanged="TitleBox_TextChanged"/>
                <TextBlock Grid.Row="3" Text="正文" Margin="42,0,0,2"
                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="12"/>
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- 行号 gutter：只读 TextBox，与 BodyBox 同字体/Padding/行高，按滚动偏移同步 ScrollToVerticalOffset → 行高天然一致零漂移 -->
                    <TextBox Grid.Column="0" x:Name="LineNumbers" Text="1"
                             IsReadOnly="True" Focusable="False" IsHitTestVisible="False"
                             Background="{StaticResource SurfaceBrush}"
                             BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                             FontFamily="{StaticResource UiFont}" FontSize="14"
                             Foreground="{StaticResource SecondaryTextBrush}"
                             TextAlignment="Right" TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Hidden"
                             HorizontalScrollBarVisibility="Hidden"
                             VerticalContentAlignment="Top"/>
                    <TextBox Grid.Column="1" x:Name="BodyBox" AcceptsReturn="True" AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             FontFamily="{StaticResource UiFont}" TextChanged="BodyBox_TextChanged"
                             SizeChanged="BodyBox_SizeChanged"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- 状态栏 -->
        <TextBlock Grid.Row="1" x:Name="StatusBar" Margin="10,2,10,8"
                   Foreground="{StaticResource HintTextBrush}" FontSize="12"
                   Text="提示: Ctrl+S 保存 | 单击列表载入 | 新建速记清空编辑区"/>
    </Grid>
</Window>
