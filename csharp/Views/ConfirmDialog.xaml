<Window x:Class="CapsLockPro.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认" Width="400" ResizeMode="NoResize" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" x:Name="DialogTitle" Text="确认"
                   FontSize="15" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>

        <!-- 消息 -->
        <TextBlock Grid.Row="1" x:Name="MessageText" Text=""
                   FontSize="14" TextWrapping="Wrap"
                   Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource Btn}" x:Name="CancelBtn" Content="取消"
                    MinWidth="84" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
            <Button Style="{StaticResource BtnPrimary}" x:Name="OkBtn" Content="确认"
                    MinWidth="84" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
