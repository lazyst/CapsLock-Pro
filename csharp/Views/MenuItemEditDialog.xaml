<Window x:Class="CapsLockPro.Views.MenuItemEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="菜单项" Height="260" Width="400" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="名称:" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NameBox" Margin="0,4" Height="30" TextChanged="UpdatePreview"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="命令:" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="CmdBox" Margin="0,4" Height="30" TextChanged="UpdatePreview"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="终端:" VerticalAlignment="Center" Margin="0,6"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="TerminalCombo" Margin="0,4" Height="30"
                  SelectionChanged="Terminal_Changed"/>
        <CheckBox Grid.Row="2" Grid.Column="2" x:Name="KeepWindowCheck" Content="保持窗口"
                  VerticalAlignment="Center" Margin="8,0,0,0" Checked="UpdatePreview" Unchecked="UpdatePreview"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="完整命令:" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="PreviewBox" Margin="0,4" Height="30" IsReadOnly="True"/>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource BtnPrimary}" Content="确定" MinWidth="80" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Style="{StaticResource Btn}" Content="取消" MinWidth="80" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
