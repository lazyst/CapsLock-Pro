<Window x:Class="CapsLockPro.Views.TerminalPathsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="终端路径" Width="560" ResizeMode="NoResize" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="终端探测状态" FontWeight="Medium" Margin="0,0,0,8"/>

        <DataGrid Grid.Row="1" x:Name="PathsGrid" Height="160"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" CanUserResizeColumns="False" CanUserResizeRows="False"
                  IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="终端" Binding="{Binding Label}" Width="120"/>
                <DataGridTextColumn Header="解析路径" Binding="{Binding Path}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Git Bash:" VerticalAlignment="Center" Margin="0,6"/>
            <TextBox  Grid.Column="1" x:Name="GitBashBox" Margin="0,4,8,4" MinHeight="30"
                      ToolTip="留空则自动探测常见安装位置"/>
            <Button  Grid.Column="2" Style="{StaticResource Btn}" Content="浏览..." MinWidth="72"
                     Click="Browse_Click"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Style="{StaticResource Btn}" Content="重新探测" Click="Refresh_Click" Margin="0,0,8,0"/>
            <Button Style="{StaticResource BtnPrimary}" Content="保存" MinWidth="80" IsDefault="True" Click="Save_Click"/>
            <Button Style="{StaticResource Btn}" Content="关闭" MinWidth="80" IsCancel="True" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
