<Window x:Class="CapsLockPro.Views.HelpPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CapsLock++ 热键速查" Width="540" Height="540"
        WindowStyle="None" Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}"
        KeyDown="Window_KeyDown" Deactivated="Window_Deactivated">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource AccentBrush}">
            <TextBlock Style="{StaticResource TitleBarText}" Text="CapsLock++ 热键速查"/>
        </Border>
        <ScrollViewer Grid.Row="1" Margin="10,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <TextBlock x:Name="ContentText" FontFamily="{StaticResource MonoFont}" FontSize="13"
                       Foreground="{StaticResource TextBrush}" TextWrapping="NoWrap"/>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
            <Button Style="{StaticResource Btn}" Content="关闭 (Esc)" MinWidth="120" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
